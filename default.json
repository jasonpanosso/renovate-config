{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base settings for every repo",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:openssf-scorecard",
    ":configMigration",
    ":disableRateLimiting",
    ":maintainLockFilesWeekly",
    ":semanticCommits",
    ":timezone(America/Detroit)",
    "github>jasonpanosso/renovate-config:annotations",
    "github>jasonpanosso/renovate-config:autoMerge",
    "github>jasonpanosso/renovate-config:labels",
    "github>jasonpanosso/renovate-config:nix",
    "github>jasonpanosso/renovate-config:semanticCommits"
  ],
  "dependencyDashboard": {
    "title": "Renovate Dashboard 🤖"
  },
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "ignorePaths": ["**/*.sops.*", "**/*.md"]
}
